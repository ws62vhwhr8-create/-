// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Entra ID 사용자
model User {
  id            String            @id @default(cuid())
  entraId       String            @unique // Entra ID에서 제공하는 고유 ID
  displayName   String
  email         String            @unique
  role          String            @default("user") // admin, user, viewer
  groupIds      String[]          @default([])
  
  // Relations
  solutionAccess SolutionAccess[]
  customerOwned  Customer[]        @relation("OwnerName")
  
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([entraId])
}

// Entra ID 그룹
model Group {
  id            String            @id @default(cuid())
  entraId       String            @unique // Entra ID 그룹 ID
  name          String
  description   String?
  
  // Relations
  solutionAccess SolutionAccess[]
  
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([entraId])
}

// 솔루션 (영업 로드맵 템플릿)
model Solution {
  id            String            @id @default(cuid())
  name          String
  description   String?
  
  // JSON 형식의 단계 데이터 (마이그레이션 이후 별도 테이블로 변환 가능)
  stages        Json              @default("[]")
  
  // Relations
  access        SolutionAccess[]
  customers     Customer[]        @relation("SolutionId")
  
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
}

// 솔루션 접근 권한
model SolutionAccess {
  id            String            @id @default(cuid())
  
  solutionId    String
  solution      Solution          @relation(fields: [solutionId], references: [id], onDelete: Cascade)
  
  // User 또는 Group 중 하나만 설정
  userId        String?
  user          User?             @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  groupId       String?
  group         Group?            @relation(fields: [groupId], references: [id], onDelete: Cascade)
  
  // 권한 수준: view, edit, admin
  accessLevel   String            @default("view")
  
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@unique([solutionId, userId])
  @@unique([solutionId, groupId])
}

// 고객
model Customer {
  id            String            @id @default(cuid())
  companyName   String
  solutionId    String
  solution      Solution          @relation("SolutionId", fields: [solutionId], references: [id])
  solutionName  String
  salesStartDate DateTime
  
  // 담당자 - User와의 관계
  ownerName     String
  userId        String?
  user          User?             @relation("OwnerName", fields: [userId], references: [id])
  
  // 상태
  status        String            @default("active") // active, completed, at-risk
  
  // Relations
  milestones    Milestone[]
  
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([solutionId])
  @@index([userId])
}

// 마일스톤 (각 고객별 진행 단계)
model Milestone {
  id            String            @id @default(cuid())
  customerId    String
  customer      Customer          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  
  stageId       String
  stageName     String
  dueDate       DateTime
  notifyDate    DateTime
  role          String
  
  // 상태: pending, in-progress, completed, overdue
  status        String            @default("pending")
  
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([customerId])
}

// NextAuth 세션 및 계정 관리 (자동 생성)
model Account {
  id                 String  @id @default(cuid())
  userId             String  @map("user_id")
  type               String
  provider           String
  providerAccountId  String  @map("provider_account_id")
  refresh_token      String?  @db.Text
  access_token       String?  @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  @db.Text
  session_state      String?

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}
